# Signer that pays gas (claimed GNO always goes to ETH1_WITHDRAWAL_ADDRESS).
# Set PK, or KEYSTORE (+ optional KEYSTORE_PASSWORD), or neither for read-only mode.
PK=
# KEYSTORE=my-claimer
# KEYSTORE_PASSWORD=

# Optional, defaults to https://rpc.gnosischain.com
# ETH_RPC=https://rpc.gnosischain.com

ETH1_WITHDRAWAL_ADDRESS=
# Minimum amount to claim, in wei (default 1 GNO)
MIN_WITHDRAW=100000000000000000
